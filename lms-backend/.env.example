APP_NAME="LMS Backend API"
APP_ENV=development
PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lms_db
DOCKER_DATABASE_URL=postgresql+asyncpg://your_user:your_password@your_postgresql_host:5432/your_database

SECRET_KEY=YOUR_SUPER_SECRET_KEY_FOR_JWT_SIGNING_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=lms_session
ENABLE_MOCK_AUTH=false
ENABLE_MOCK_PAYMENTS=false
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_WEBHOOK_SECRET
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=lms-storage
MINIO_PUBLIC_URL=http://localhost:9000

REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0
