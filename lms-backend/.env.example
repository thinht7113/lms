APP_NAME="LMS Backend API"
APP_ENV=development
ENABLE_MOCK_PAYMENTS=false
PORT=8000

DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_database
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=60

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AUTH_COOKIE_DOMAIN=
API_PUBLIC_URL=http://localhost:8000

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=

VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=

MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=lms-storage
MINIO_PUBLIC_URL=http://localhost:9000
DOCKER_DATABASE_URL=postgresql+asyncpg://your_user:your_password@your_postgresql_host:5432/your_database
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_WEBHOOK_SECRET

# Redis Config
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
