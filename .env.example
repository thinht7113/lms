# =============================================================================
#  Lumina LMS - Docker Environment Variables
#  Sao chép file này thành .env trước khi chạy: cp .env.example .env
# =============================================================================

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=lms_database

# ===== JWT Security =====
# QUAN TRỌNG: Đổi SECRET_KEY này trong môi trường production thực tế!
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_WEBHOOK_SECRET

# ===== MinIO Object Storage =====
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

# ===== Public URLs / CORS =====
API_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
