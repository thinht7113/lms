DATABASE_URL=postgresql+asyncpg://user:password@host:5432/lms_database

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=lms-storage
MINIO_USE_SSL=false
MINIO_PUBLIC_URL_PREFIX=http://localhost:9000/lms-storage

CRAWLER_DEFAULT_HEADLESS=true
CRAWLER_HOCTAPGIARE_STORAGE_STATE_PATH=./storage_states/hoctapgiare.json
CRAWLER_HOCTAPGIARE_EMAIL=
CRAWLER_HOCTAPGIARE_PASSWORD=
CRAWLER_KHOAHOCRE_EMAIL=
CRAWLER_KHOAHOCRE_PASSWORD=
CRAWLER_COURSE_TIMEOUT_SECONDS=420
CRAWLER_LESSON_TIMEOUT_SECONDS=45
CRAWLER_RESOLVE_VIDEO_TIMEOUT_SECONDS=18
CRAWLER_JOB_TIMEOUT_SECONDS=1800
CRAWLER_MIRROR_VIDEO_FILES=true
CRAWLER_ALLOW_PRIVATE_ASSET_URLS=false
CRAWLER_IMAGE_MAX_MB=12
CRAWLER_PDF_MAX_MB=80
CRAWLER_VIDEO_MAX_MB=1024
CRAWLER_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=15
CRAWLER_DOWNLOAD_READ_TIMEOUT_SECONDS=300
